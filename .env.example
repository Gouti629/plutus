# Required to run the Navigator agent and the Anthropic side of the benchmark.
ANTHROPIC_API_KEY=

# Model used by the FNOL Navigator agent for extraction + decisioning.
NAVIGATOR_MODEL=claude-sonnet-4-5

# Model used by benchmark/api_bench.py (the cheap/volume side of the Part 4 comparison).
BENCHMARK_API_MODEL=claude-haiku-4-5

# OpenAI-compatible endpoint for a self-hosted vLLM server, used by benchmark/vllm_bench.py.
# Not required to run the agent or dashboard.
VLLM_ENDPOINT=http://localhost:8000/v1
VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct-AWQ
