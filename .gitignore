.venv/
__pycache__/
*.pyc
.env
agent/data/traces/*.json
!agent/data/traces/.gitkeep
benchmark/results/*.json
node_modules/

# dashboard/data.js is intentionally tracked (not ignored): Vercel serves the
# dashboard as a static site with no build step and no backend, so the last
# generated trace bundle has to be committed for the deployed site to show
# anything. Regenerate it locally with `python -m agent.run_batch` and commit
# the update whenever you want the hosted snapshot refreshed.
